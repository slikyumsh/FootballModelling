*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/
pip-wheel-metadata/

build/
dist/
*.egg-info/
.eggs/
*.whl

# Ruff / type checkers
.ruff_cache/
.mypy_cache/
.pytest_cache/

